# Klara AI Assistant - Environment Configuration
# Copy this file and update with your actual values

# =============================================================================
# API Configuration
# =============================================================================
# Your Klara AI API endpoint
API_BASE_URL=https://your-klara-api-endpoint.com
# API token for authentication (if required)
POLKASSEMBLY_AI_TOKEN=your_api_token_here

# =============================================================================
# Firebase Configuration (Required)
# =============================================================================
# Get these values from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# =============================================================================
# PostgreSQL Configuration (Optional - for analytics and logging)
# =============================================================================
# Set DISABLE_POSTGRES=true to disable PostgreSQL features
DISABLE_POSTGRES=false

# PostgreSQL connection details
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=polkassembly
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_SSL=false

# =============================================================================
# Application Settings
# =============================================================================
# Environment (development, production)
NODE_ENV=development

# Number of previous messages to include in conversation context
CONVERSATION_HISTORY_LIMIT=5

# JWT secret for token signing (use a strong, random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production


